# AI Provider API Keys
# You only need to configure the providers you want to use.
# The system will automatically use available providers.

# OpenAI API Key (Required for GPT-4 and GPT-3.5)
# Get key at: https://platform.openai.com/account/api-keys
# Cost: Pay-per-use
OPENAI_API_KEY=your_openai_key_here

# Anthropic API Key (Required for Claude models)
# Get key at: https://console.anthropic.com/account/keys
# Cost: Pay-per-use
ANTHROPIC_API_KEY=your_anthropic_key_here

# Google API Key (Required for Gemini models)
# Get key at: https://makersuite.google.com/app/apikey
# Cost: Free tier available
GOOGLE_API_KEY=your_google_key_here

# Hugging Face API Key (Required for open-source models)
# Get key at: https://huggingface.co/settings/tokens
# Cost: Free for most models
HUGGINGFACE_API_KEY=your_huggingface_key_here

# Cohere API Key (Optional)
# Get key at: https://dashboard.cohere.ai/api-keys
# Cost: Free tier available
COHERE_API_KEY=your_cohere_key_here

# NLTK Configuration
# Optional: Set custom NLTK data directory
# If not set, defaults to ./data/nltk_data
# NLTK_DATA=/path/to/your/nltk_data

# Example paths:
# Windows: NLTK_DATA=C:/Users/YourUser/AppData/Roaming/nltk_data
# Linux/Mac: NLTK_DATA=/usr/local/share/nltk_data

# Security Note:
# 1. Never commit this file with real API keys
# 2. Keep your API keys secure and never share them
# 3. Regularly rotate your API keys
# 4. Set appropriate usage limits in your API provider dashboards
